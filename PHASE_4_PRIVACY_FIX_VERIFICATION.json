  "defect_analysis": {
    "target_file": "backend/observability/redaction.py",
    "vulnerable_function": "pseudonymize_student_id(student_id)",
    "vulnerable_line": 87,
    "vulnerable_code": "secret_key = os.environ.get(\"TELEMETRY_HMAC_SECRET\", \"gyaan_ai_telemetry_pseudonym_salt_2026\").encode(\"utf-8\")",
    "security_risk": "Hardcoded predictable salt allowed deterministic correlation of student identifiers across disparate environments if the environment variable was unset or leaked.",
    "resolution": "Removed hardcoded fallback salt completely. Enforced that HMAC secret is strictly loaded from TELEMETRY_HMAC_SECRET. If missing, empty, or whitespace, the function returns None, causing all student identifiers to be completely omitted from telemetry dictionaries and lists."
  },
