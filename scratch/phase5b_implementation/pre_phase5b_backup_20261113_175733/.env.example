# ==============================================================================
# Gyaan AI — Environment Configuration Example (.env.example)
# Safe reference template for local multi-agent educational deployment.
# Copy to .env (or frontend/.env.local) and adjust values as needed.
# ==============================================================================

# Local Ollama LLM Service Configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=120

# FastAPI Application Backend Server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_LOG_LEVEL=info

# Next.js Application Frontend
FRONTEND_HOST=localhost
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# SQLite Database
DATABASE_PATH=data/gyaan_ai.db

# Authentication Security Settings
JWT_SECRET_KEY=change_this_to_a_secure_random_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==============================================================================
# Phase 4: Observability, Distributed Tracing & Langfuse Configuration
# ==============================================================================
# Enable or disable external Langfuse telemetry integration (default: false)
LANGFUSE_ENABLED=false
# Langfuse Public API Key (e.g. pk-lf-...)
LANGFUSE_PUBLIC_KEY=pk-lf-placeholder-public-key
# Langfuse Secret API Key (e.g. sk-lf-...)
LANGFUSE_SECRET_KEY=sk-lf-placeholder-secret-key
# Langfuse Host URL (defaults to Langfuse Cloud or self-hosted endpoint)
LANGFUSE_HOST=https://cloud.langfuse.com
# Maximum trace records retained in bounded memory buffer
OBSERVABILITY_MAX_TRACES=1000
# Maximum point-in-time events retained in bounded memory buffer
OBSERVABILITY_MAX_EVENTS=5000
